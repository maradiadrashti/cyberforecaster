# Copy this file to .env and fill in your values.
#
# VITE_CAPTURE_HOST — IP or hostname of the machine running capture_server.py
#   Local:  127.0.0.1
#   Remote: 192.168.1.50  (or whatever the server's IP is)
#
# VITE_CAPTURE_PORT — Port capture_server.py listens on (default 8080)
#   Can also be set via the CAPTURE_PORT env var when starting the Python server.

VITE_CAPTURE_HOST=127.0.0.1
VITE_CAPTURE_PORT=8080
